{
    "version": "2.4.4rc7",
    "description": "The open source port of OpenZFS on Windows",
    "homepage": "https://github.com/openzfsonwindows/openzfs",
    "license": "Freeware",
    "url": "https://github.com/openzfsonwindows/openzfs/releases/download/zfswin-2.4.4rc7/OpenZFSOnWindows-2.4.4rc7.exe#/setup.exe",
    "hash": "c15492ee98fdd7eaacd4dfb954d4d712d1eef2786ad2f2997c8c98d454ea2fee",
    "installer": {
        "args": [
            "/VERYSILENT",
            "/NOCANCEL",
            "/NORESTART",
            "/CLOSEAPPLICATIONS"
        ]
    },
    "checkver": {
        "script": [
            "$resp = Invoke-WebRequest -Uri 'https://api.github.com/repos/openzfsonwindows/openzfs/releases'",
            "$json = $resp.Content | ConvertFrom-Json",
            "$tag = $json[0].tag_name -replace 'zfswin-',''",
            "$version = ($json[0].assets | Sort-Object updated_at)[-1].name -replace 'OpenZFSOnWindows-','' -replace '.exe',''",
            "Write-Output \"$version $tag\""
        ],
        "regex": "(?<version>.+)\\s(?<tag>.+)"
    },
    "autoupdate": {
        "url": "https://github.com/openzfsonwindows/openzfs/releases/download/zfswin-$matchTag/OpenZFSOnWindows-$version.exe#/setup.exe"
    }
}
