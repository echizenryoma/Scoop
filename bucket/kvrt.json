    ],
    "checkver": {
        "script": [
            "$dl_url = 'https://devbuilds.s.kaspersky-labs.com/devbuilds/KVRT/latest/full/KVRT.exe'",
            "$dl = cache_path 'kvrt' 'unknown' $dl_url",
            "Invoke-WebRequest $dl_url -OutFile $dl",
            "$ver = (Get-Item $dl).VersionInfo.ProductVersion",
            "Move-Item -Force $dl (cache_path 'kvrt' $ver $dl_url)",
            "$ver"
        ],
        "regex": "(?<version>.+)"
    },
    "autoupdate": {
        "url": "https://devbuilds.s.kaspersky-labs.com/devbuilds/KVRT/latest/full/KVRT.exe"
    }
}
